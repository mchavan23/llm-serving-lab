# Copy to .env and fill in real values.
# .env is gitignored. Never commit it.
#
# Every line must be KEY=VALUE. A bare value with no key name will be
# executed as a shell command by anything that sources this file.

# Hugging Face read token (for gated models like Llama-3.1)
HF_TOKEN=

# S3 store (SeaweedFS) - installed into the kind cluster by
# scripts/install-seaweedfs.sh --kind.
# S3_ENDPOINT is the host-side address: kind maps host port 9000 to
# NodePort 30900 on the node container. From inside the cluster the
# address is http://seaweedfs-s3.seaweedfs.svc.cluster.local:8333 instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=models
