# --- Secrets: never commit ---
.env
*.key
*.pem
kubeconfig*
scripts/.session.env

# --- Model weights: gigabytes, never commit ---
models/
*.safetensors
*.bin
*.gguf
*.pt
*.onnx

# --- Local notes, kept outside the repo ---
CONTEXT.md
*-CONTEXT.md

# --- Local scratch ---
tmp/
logs/
*.log
.session-active
.DS_Store

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Any .env variant (backups, copies) holds real credentials. Only the
# template is tracked.
.env*
!.env.example
# benchmark.sh run lock (per run dir)
benchmarks/results/**/.lock
# Raw per-request GuideLLM records: published as a Release asset, not committed
# (see benchmarks/results/RAW-DATA.md). Earlier kind runs stay tracked as-is.
benchmarks/results/**/guidellm.json
